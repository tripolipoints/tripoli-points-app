+// Security (stored XSS fix): only https URLs or base64 raster data images are accepted as logos; anything else → default pin.
+const tpSafeImgSrc=u=>{if(typeof u!=='string')return'';u=u.trim();if(/["'<>`\s\\]/.test(u))return'';
+  if(/^data:image\/(png|jpe?g|webp|gif);base64,[A-Za-z0-9+/=]+$/i.test(u))return u;
+  try{const x=new URL(u);return x.protocol==='https:'?x.href:''}catch(e){return''}};
+const tpStoreLogoSrc=m=>(m&&tpSafeImgSrc(m.logo))||PIN_T;
+const tpStoreLogoHtml=(m,cls='tp21-store-logo')=>`<img class="${esc(cls)}" src="${esc(tpStoreLogoSrc(m))}"onerror="this.onerror=null;this.src=PIN_T" alt="شعار ${esc(m.name||'Tripoli Points')}">`;
